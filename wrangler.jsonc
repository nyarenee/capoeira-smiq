{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "smiq",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Custom domain for the production Worker, created via the Cloudflare
  // dashboard (Workers & Pages > smiq > Settings > Domains & Routes).
  // Declared here too so a plain `wrangler deploy` with no routes in config
  // doesn't silently remove it (confirmed behavior, see PROJECT_NOTES.md
  // "Custom domains").
  "routes": [{ "pattern": "www.capoeirainternational.com", "custom_domain": true }],
  // Wrangler defaults workers_dev to false once routes/custom_domain are
  // declared (confirmed the hard way — this broke the live workers.dev URL
  // on the first deploy after adding routes above). Keep it on explicitly:
  // smiq.capoeirainternational.workers.dev must keep working unchanged.
  "workers_dev": true,
  "env": {
    // Staging: separate Worker + Neon branch, deployed on demand via
    // `npm run deploy:staging`. See README.md "Staging" section.
    "staging": {
      "name": "smiq-staging",
      // `routes` is inheritable — without this, env.staging would inherit
      // the production www.capoeirainternational.com custom domain and
      // REASSIGN it to smiq-staging on every staging deploy (confirmed via
      // Wrangler's own warning: "Deploying this environment will reassign
      // these custom domains away from the top-level Worker"). Staging
      // only ever serves smiq-staging.workers.dev.
      "routes": [],
    },
  },
}
