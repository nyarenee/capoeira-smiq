# Copy this to .env.local (local dev) or .env.staging (staging deploy, see
# README.md "Staging"). Same keys in both — only the values differ.

# Neon Postgres — direct connection string (pooled recommended).
DATABASE_URL=postgres://user:password@host/db?sslmode=require&channel_binding=require

# Resend — server-side only. No sandbox mode exists; staging reuses the real
# key (see README.md "Staging").
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
OWNER_NOTIFICATION_EMAIL=you@example.com

# Inlined into the client bundle at build time, not read at runtime — see
# README.md "Deploy" and "Staging" for why this matters for non-local builds.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudflare Turnstile — bot protection on the SMIQ form.
# Local dev / production: the real widget (localhost/127.0.0.1 are
# allow-listed alongside the production domain).
# Staging: use Cloudflare's published "always passes" test keys instead —
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA — so
# automated submissions don't need a human to solve a captcha. The secret
# key has more zeros than the sitekey and is easy to miscount by eye; verify
# with a siteverify call using the dummy token XXXX.DUMMY.TOKEN.XXXX before
# trusting it (see https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
TURNSTILE_SECRET_KEY=...

# Kit (ConvertKit) — server-side only. No sandbox mode exists; staging reuses
# the real key (see README.md "Staging").
KIT_API_KEY=kit_...

# Teacher role tags (applied when segment=teacher)
KIT_TAG_ID_ROLE_CLASSES=...
KIT_TAG_ID_ROLE_OWN_SCHOOL=...
KIT_TAG_ID_ROLE_ADMIN=...
KIT_TAG_ID_ROLE_ONLINE=...

# Graduation level tags (applied when segment=teacher)
KIT_TAG_ID_GRAD_MONITOR=...
KIT_TAG_ID_GRAD_PROFESSOR=...
KIT_TAG_ID_GRAD_CONTRA_MESTRE=...
KIT_TAG_ID_GRAD_MESTRE=...
KIT_TAG_ID_GRAD_GRAO_MESTRE=...
KIT_TAG_ID_GRAD_UNGRADED=...

# Language level tags
KIT_TAG_ID_LANG_EN=...
KIT_TAG_ID_LANG_PT=...
KIT_TAG_ID_LANG_ES=...
KIT_TAG_ID_LANG_FR=...

# Bearer token for the private GET /api/smiq/responses endpoint. Generate a
# fresh one per environment — don't reuse production's for staging.
API_AUTH_TOKEN=...
